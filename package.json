{
  "name": "swapfather",
  "version": "0.1.0",
  "description": "SwapFather — Telegram commerce on the uSwap engine: sell digital products for crypto, run a swap service, or host a fleet of branded bots.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "fleet": "bun run src/fleet.ts",
    "typecheck": "tsc --noEmit",
    "setup:telegram": "bun run scripts/setup-telegram.ts",
    "test": "bun test"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.0",
    "@types/bun": "^1.1.0"
  }
}
