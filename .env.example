# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# uSwap Partner API key (create one at https://partner.uswap.net → API Keys)
# Needs scopes: catalog:read, bridges:read, bridges:write, intents:read, intents:write
USWAP_API_KEY=

# uSwap Partner API base URL (default: https://partner-api.uswap.net)
USWAP_API_BASE=https://partner-api.uswap.net

# Where SQLite state is stored (orders, user prefs). Default: ./data/bestb4u.db
DATABASE_PATH=./data/bestb4u.db

# Optional: comma-separated Telegram user ids who can run admin commands
ADMIN_USER_IDS=
